# Copy to deploy.env before deployment.
TZ=Asia/Shanghai
DATA_DIR=/volume1/docker/kid-study/data
WEB_PORT=8080
PROMETHEUS_PORT=9090

# Local builds use these image names and tags.
IMAGE_NAMESPACE=local
IMAGE_TAG=latest

LOG_LEVEL=info
COOKIE_SECURE=false
POSTGRES_PASSWORD_FILE=./secrets/postgres_password

# Generate the following two values with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-separate-random-secret

DEV_PARENT_PASSWORD=replace-with-a-strong-parent-password
DEV_CHILD_PIN=replace-with-a-private-child-pin

# Leave empty when model configuration is managed in the parent workspace.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
