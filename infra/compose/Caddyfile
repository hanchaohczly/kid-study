:8080 {
  encode zstd gzip

  route {
    @metrics path /api/metrics
    respond @metrics 404

    handle_path /api/* {
      reverse_proxy api:3000
    }

    handle {
      root * /srv
      try_files {path} /index.html
      file_server
    }
  }

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}
