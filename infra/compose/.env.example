DATA_DIR=/volume1/docker/kid-study
WEB_PORT=8080
PROMETHEUS_PORT=9090
COOKIE_SECURE=false
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
# Used by scripts/backup-postgres.sh and scripts/restore-postgres.sh.
BACKUP_PASSPHRASE_FILE=./secrets/backup_passphrase
JWT_SECRET=replace-with-at-least-32-random-characters
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-separate-random-secret
DEV_PARENT_PASSWORD=replace-with-a-strong-parent-password
DEV_CHILD_PIN=replace-with-a-private-child-pin
LLM_API_URL=http://llm-gateway:8000/v1/chat/completions
LLM_API_KEY=replace-with-gateway-api-key
LLM_MODEL=replace-with-model-name
